{
  "name": "vibecoding-students",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@vibe/web",
    "import": "tsx scripts/import.ts",
    "import:dry": "tsx scripts/import.ts --dry-run",
    "recommend": "tsx scripts/recommend.ts",
    "recommend:dry": "tsx scripts/recommend.ts --dry",
    "spheres": "tsx scripts/spheres.ts",
    "spheres:dry": "tsx scripts/spheres.ts --dry",
    "enrich:status": "tsx scripts/enrich-status.ts",
    "enrich:status:dry": "tsx scripts/enrich-status.ts --dry",
    "screenshots": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "test:parser": "vitest run --dir packages/parser",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
